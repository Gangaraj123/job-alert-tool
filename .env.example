# Copy to .env for local development. In production these are set as
# GitHub Actions secrets (for the cron job) and Streamlit Cloud secrets
# (for the UI) — see README.md.

TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Gmail SMTP for the daily digest. GMAIL_APP_PASSWORD is a 16-char app
# password from https://myaccount.google.com/apppasswords (requires 2-Step
# Verification to be on) — NOT your normal Gmail password.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional: where the digest is sent, if different from GMAIL_ADDRESS.
DIGEST_TO_EMAIL=you@gmail.com

# Used by the "Add company" search in the UI to actually find a company's
# real careers page (beyond common URL-pattern guesses), via Gemini with
# Google Search grounding. Get one at https://aistudio.google.com/apikey
# Optional — without it, discovery falls back to pattern-guessing only.
GEMINI_API_KEY=
