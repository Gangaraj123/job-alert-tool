# Copy to .env for local development. In production these are set as
# GitHub Actions secrets (for the cron job) and Streamlit Cloud secrets
# (for the UI) — see README.md.

TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Gmail SMTP for the daily digest. GMAIL_APP_PASSWORD is a 16-char app
# password from https://myaccount.google.com/apppasswords (requires 2-Step
# Verification to be on) — NOT your normal Gmail password.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional: where the digest is sent, if different from GMAIL_ADDRESS.
DIGEST_TO_EMAIL=you@gmail.com

# Powers AI-first career-page discovery and search-result reranking in the
# "Add company" flow. Optional — without either Vertex or the key below,
# both features fall back to non-AI behavior.
#
# Preferred: Vertex AI, billed against a GCP project (e.g. free trial
# credits) instead of the AI Studio key's thin free quota. Needs a service
# account with the "Vertex AI User" role; paste its full key JSON as one
# line.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
GOOGLE_VERTEX_CREDENTIALS_JSON=

# Fallback if Vertex isn't configured: a plain AI Studio key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
