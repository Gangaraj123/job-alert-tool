# Copy this to .streamlit/secrets.toml for local dev, or paste these into
# the "Secrets" box in Streamlit Community Cloud's app settings.
# (The UI only needs the DB secrets — email sending happens in the GitHub
# Actions cron job, not from the UI.)

TURSO_DATABASE_URL = "libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN = "your-turso-auth-token"
