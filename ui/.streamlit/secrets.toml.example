# Copy this to .streamlit/secrets.toml for local dev, or paste these into
# the "Secrets" box in Streamlit Community Cloud's app settings.
# (Email sending happens in the GitHub Actions cron job, not from the UI,
# so Gmail secrets aren't needed here.)

TURSO_DATABASE_URL = "libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN = "your-turso-auth-token"

# Optional: powers the "Add company" search's career-page discovery beyond
# pattern-guessing. Free tier at https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY = ""
