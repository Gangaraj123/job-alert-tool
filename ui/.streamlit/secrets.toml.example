# Copy this to .streamlit/secrets.toml for local dev, or paste these into
# the "Secrets" box in Streamlit Community Cloud's app settings.
# (Email sending happens in the GitHub Actions cron job, not from the UI,
# so Gmail secrets aren't needed here.)

TURSO_DATABASE_URL = "libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN = "your-turso-auth-token"

# Optional: powers AI-first career-page discovery and search-result
# reranking in the "Add company" flow. Without either of these, both
# features just fall back to their non-AI behavior.
#
# Preferred: Vertex AI, billed against a GCP project (e.g. free trial
# credits) instead of the AI Studio key's thin free quota. Needs a service
# account with the "Vertex AI User" role; paste its full key JSON as one
# line for GOOGLE_VERTEX_CREDENTIALS_JSON.
VERTEX_PROJECT = ""
VERTEX_LOCATION = "us-central1"
GOOGLE_VERTEX_CREDENTIALS_JSON = ""

# Fallback if Vertex isn't configured: a plain AI Studio key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY = ""
